#!/bin/sh
# Block commit messages that contain keys, passwords or personal details.
exec python3 -c "import sys,os;sys.path.insert(0,os.path.join(sys.argv[2],'tools'));import checksecrets as C;f=C.scan_text('commit message',open(sys.argv[1],encoding='utf-8',errors='replace').read());sys.exit(0 if C.report(f,'the commit message') else 1)" "$1" "$(git rev-parse --show-toplevel)"
